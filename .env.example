# Copy to .env and fill in real values.
# Postgres connection strings used by drizzle-orm / pg (admin/migrations, then runtime/tests).
DATABASE_URL="postgres://postgres:GANTI_PASSWORD_ANDA@127.0.0.1:5432/ledger"
APP_DATABASE_URL="postgres://app_user:app_pw@127.0.0.1:5432/ledger"
BETTER_AUTH_SECRET="change-me-in-real-env"
BETTER_AUTH_URL="http://localhost:3000"
TRUSTED_ORIGINS=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set "1" untuk menampilkan tombol "Lanjut dengan Google" (butuh kredensial di atas).
NEXT_PUBLIC_GOOGLE_ENABLED=""
RESEND_API_KEY=""
EMAIL_FROM="Neraca <noreply@neraca.id>"
S3_ENDPOINT="http://127.0.0.1:8333"
S3_BUCKET="neraca-docs"
S3_ACCESS_KEY="demo"
S3_SECRET_KEY="demo"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_EMBED_MODEL="gemini-embedding-001"
# Mode tanpa jaringan untuk dev/e2e: AI deterministik, email auth hanya dicatat di log.
AI_MOCK="1"
ASSISTANT_MONTHLY_LIMIT="200"
# Optional persona (future multi-persona). Nara adalah nama default asisten.
ASSISTANT_NAME="Nara"
NEXT_PUBLIC_ASSISTANT_NAME="Nara"
