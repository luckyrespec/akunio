# Copy to .env and fill in real values.
# Postgres connection strings used by drizzle-orm / pg (admin/migrations, then runtime/tests).
DATABASE_URL="postgres://postgres:GANTI_PASSWORD_ANDA@127.0.0.1:5432/ledger"
APP_DATABASE_URL="postgres://app_user:app_pw@127.0.0.1:5432/ledger"
# Neon Auth (managed Better Auth). Base URL unik per branch — lihat Neon Console
# (Project → Branch → Auth) atau get_auth via MCP. Cookie secret min 32 char.
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="change-me-min-32-chars-in-real-env"
# Branch e2e khusus Playwright (verifikasi email OFF di branch ini).
E2E_DATABASE_URL="postgresql://neondb_owner:xxx@ep-yyy-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
E2E_NEON_AUTH_BASE_URL="https://ep-yyy.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth"
# Set "1" untuk menampilkan tombol "Lanjut dengan Google" (aktifkan dulu
# provider Google di Neon dashboard untuk branch terkait).
NEXT_PUBLIC_GOOGLE_ENABLED=""
S3_ENDPOINT="http://127.0.0.1:8333"
S3_BUCKET="neraca-docs"
S3_ACCESS_KEY="demo"
S3_SECRET_KEY="demo"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_EMBED_MODEL="gemini-embedding-001"
# Mode tanpa jaringan untuk dev/e2e: AI deterministik (auth via Neon, tidak di-mock).
AI_MOCK="1"
ASSISTANT_MONTHLY_LIMIT="200"
# Optional persona (future multi-persona). Nara adalah nama default asisten.
ASSISTANT_NAME="Nara"
NEXT_PUBLIC_ASSISTANT_NAME="Nara"
